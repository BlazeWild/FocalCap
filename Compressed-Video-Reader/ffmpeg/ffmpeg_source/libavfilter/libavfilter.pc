exec_prefix=${prefix}
libdir=/teamspace/studios/this_studio/.local/cvreader-ffmpeg/lib
includedir=/teamspace/studios/this_studio/.local/cvreader-ffmpeg/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 8.44.100
Requires: libswscale >= 6.7.100, libavformat >= 59.27.100, libavcodec >= 59.37.100, libswresample >= 4.7.100, libavutil >= 57.28.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavfilter -pthread -lm -latomic -lva
Libs.private: 
Cflags: -I${includedir}
